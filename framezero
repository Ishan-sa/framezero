#!/usr/bin/env python3
"""framezero — reverse-engineer what works on a niche's Instagram Reels.

  ./framezero new  <project> --niche "..." --mode informational=a,b --mode funny=c
  ./framezero run  <project> [--mode M] [--only handle] [--top N] [--bottom N]
  ./framezero profile <handle>               full dossier: who they are, what they post
  ./framezero topics  <handle> [--define f]  which SUBJECTS beat their own baseline
  ./framezero hooks   <handle> [--define f]  how they open, and whether it matters
  ./framezero signals <project> [--mode M]   which subjects and hooks REPLICATE
  ./framezero voice <handle> [--project P]   derive a creator's voice fingerprint
  ./framezero check <script> --like <handle>  score a draft against that voice
  ./framezero show <project>

`run` is safe to repeat: every stage skips work already on disk.
"""
import subprocess, sys, pathlib, argparse

ROOT = pathlib.Path(__file__).resolve().parent
BIN = ROOT / "bin"
sys.path.insert(0, str(BIN))
import project as P


def sh(script, *args):
    cmd = [sys.executable, str(BIN / script), *[str(a) for a in args]]
    r = subprocess.run(cmd)
    return r.returncode == 0


def head(msg):
    print(f"\n\033[1m{msg}\033[0m", file=sys.stderr, flush=True)


def run(a):
    cfg = P.load(a.project)
    handles = P.creators(cfg)
    if a.mode:
        handles = [h for h in handles if a.mode in P.modes_for(cfg, h)]
    if a.only:
        handles = [h for h in handles if h == a.only.lstrip("@")]
    if not handles:
        sys.exit("no creators match")

    for h in handles:
        modes = ", ".join(P.modes_for(cfg, h)) or "unassigned"
        head(f"@{h}  [{modes}]")

        if not (ROOT / "data" / h / "index.json").exists():
            if not sh("scrape.py", h):
                print(f"  scrape failed for @{h} — skipping", file=sys.stderr)
                continue
        else:
            print("  index.json present — skipping scrape "
                  "(delete it to re-pull)", file=sys.stderr)

        rank = ["rank.py", h, "--top", a.top, "--bottom", a.bottom,
                "--window", cfg.get("baseline_window_days", 90)]
        since = P.since_for(cfg, h)
        if since:
            rank += ["--since", since]
        sh(*rank)
        sh("fetch.py", h)
        sh("listen.py", h, "--project", a.project)
        sh("corpus.py", h)
        sh("report.py", h, "--project", a.project)
        # These three read the index already on disk and make no requests of
        # their own. profile.py runs last because posts.csv folds in whatever
        # topics and hooks found.
        topics = ["topics.py", h]
        hooks = ["hooks.py", h]
        if cfg.get("topic_spec"):
            topics += ["--define", ROOT / cfg["topic_spec"]]
        if cfg.get("hook_spec"):
            hooks += ["--define", ROOT / cfg["hook_spec"]]
        sh(*topics)
        sh(*hooks)
        sh("profile.py", h)

    # The niche lexicon is derived from scraped captions, so it can only be
    # built once there is data. Refresh it before the cross-creator pass.
    head("niche lexicon")
    sh("project.py", "lexicon", a.project)

    # Voice runs after every creator, not inside the loop: a signature phrase
    # is one this creator uses and the others do not, so it cannot be computed
    # until the others exist.
    for h in handles:
        head(f"voice: @{h}")
        sh("voice.py", "profile", h, "--project", a.project)

    for mode in ([a.mode] if a.mode else list(cfg["modes"])):
        head(f"cross-creator: {mode}")
        sh("aggregate.py", a.project, mode)
        # Same argument as aggregate.py, applied to subject matter and hooks
        # rather than to structure.
        sh("replicate.py", a.project, "--mode", mode)

    print(f"""
Done. Hand these to your agent:

  data/_projects/{a.project}/<mode>.md   which STRUCTURE findings replicate (read first)
  data/_projects/{a.project}/signals-<mode>.md  which SUBJECTS and HOOKS replicate
  data/<handle>/profile.md               who the creator is, what they post, how they earn
  data/<handle>/topics.md                which SUBJECTS beat their own baseline
  data/<handle>/hooks.md                 how the winners open — the transferable part
  data/<handle>/report.md                per-creator countable deltas — structure
  data/<handle>/voice.md                 how that creator SOUNDS — dials + exemplars
  data/<handle>/corpus.md                the transcripts themselves
  prompts/extract.md, prompts/emit.md    how to turn that into skills

Then check every draft against the voice you are writing in:

  ./framezero check script.txt --like <handle>
""", file=sys.stderr)


if __name__ == "__main__":
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    n = sub.add_parser("new", help="create a project")
    n.add_argument("name"); n.add_argument("--niche", required=True)
    n.add_argument("--vocabulary"); n.add_argument("--mode", action="append")
    n.add_argument("--since")

    s = sub.add_parser("show", help="project status")
    s.add_argument("name")

    p = sub.add_parser("profile",
                       help="full dossier for one creator — no transcription")
    p.add_argument("handle")
    p.add_argument("--refresh", action="store_true",
                   help="re-pull the index even if one is already on disk")
    p.add_argument("--topics", help="topic spec passed to the topics stage")
    p.add_argument("--hooks", help="hook archetype spec passed to the hooks stage")

    t = sub.add_parser("topics",
                       help="which subjects beat this creator's own baseline")
    t.add_argument("handle")
    t.add_argument("--define", help="your own topics (.json or .txt)")
    t.add_argument("--min-reels", type=int, default=6)
    t.add_argument("--since")
    t.add_argument("--q", type=float, default=0.10,
                   help="false-discovery rate (default 0.10)")

    sg = sub.add_parser("signals",
                        help="which subjects and hooks replicate across creators")
    sg.add_argument("project")
    sg.add_argument("--mode", help="only creators studied for this mode")
    sg.add_argument("--handles", help="compare these handles instead, comma "
                                      "separated — no project edit needed")

    hk = sub.add_parser("hooks", help="how they open, and whether it matters")
    hk.add_argument("handle")
    hk.add_argument("--define", help="your own hook archetypes (.json or .txt)")
    hk.add_argument("--seconds", type=float, default=3.0)
    hk.add_argument("--min-reels", type=int, default=6)
    hk.add_argument("--since")

    v = sub.add_parser("voice", help="derive a creator's voice fingerprint")
    v.add_argument("handle"); v.add_argument("--project")

    k = sub.add_parser("check", help="score a draft script against a voice")
    k.add_argument("script")
    k.add_argument("--like", required=True,
                   help="handle, or comma-separated handles to pool")
    k.add_argument("--wpm", type=float, default=210,
                   help="your own speaking rate (time yourself: words/minutes)")

    r = sub.add_parser("run", help="run the pipeline for a project")
    r.add_argument("project")
    r.add_argument("--mode", help="only creators studied for this mode")
    r.add_argument("--only", help="only this handle")
    r.add_argument("--top", type=int, default=15)
    r.add_argument("--bottom", type=int, default=15)

    a = ap.parse_args()
    if a.cmd == "run":
        run(a)
    elif a.cmd == "profile":
        h = a.handle.lstrip("@")
        idx = ROOT / "data" / h / "index.json"
        if a.refresh and idx.exists():
            idx.unlink()
        # The dossier is the cheap door into this tool: one scrape, no whisper,
        # about a minute. So it pulls the index itself rather than making the
        # user run a separate stage first.
        if not idx.exists() and not sh("scrape.py", h):
            sys.exit(f"scrape failed for @{h}")
        # All three read the same index and make no requests. Together they
        # are the whole-account answer: who they are, what works, how they
        # open it. profile.py runs last so posts.csv can fold in the rest.
        topics = ["topics.py", h] + (["--define", a.topics] if a.topics else [])
        hooks = ["hooks.py", h] + (["--define", a.hooks] if a.hooks else [])
        ok = sh(*topics)
        ok = sh(*hooks) and ok
        sys.exit(0 if sh("profile.py", h) and ok else 1)
    elif a.cmd == "signals":
        args = ["replicate.py", a.project]
        for flag in ("mode", "handles"):
            if getattr(a, flag, None):
                args += [f"--{flag}", getattr(a, flag)]
        sys.exit(0 if sh(*args) else 1)
    elif a.cmd in ("topics", "hooks"):
        args = [f"{a.cmd}.py", a.handle.lstrip("@")]
        for flag in ("define", "since", "seconds", "q"):
            if getattr(a, flag, None) is not None:
                args += [f"--{flag}", getattr(a, flag)]
        args += ["--min-reels", a.min_reels]
        sys.exit(0 if sh(*args) else 1)
    elif a.cmd == "voice":
        args = ["voice.py", "profile", a.handle]
        if a.project:
            args += ["--project", a.project]
        sys.exit(0 if sh(*args) else 1)
    elif a.cmd == "check":
        sys.exit(0 if sh("voice.py", "check", a.script,
                         "--like", a.like, "--wpm", a.wpm) else 1)
    else:
        args = ["project.py", a.cmd, a.name]
        for flag in ("niche", "vocabulary", "since"):
            if getattr(a, flag, None):
                args += [f"--{flag}", getattr(a, flag)]
        for m in (getattr(a, "mode", None) or []):
            args += ["--mode", m]
        sys.exit(0 if sh(*args) else 1)
